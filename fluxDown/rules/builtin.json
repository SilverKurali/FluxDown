    {
      "id": "builtin.normalize.query-ext",
      "version": 1,
      "tier": "builtin",
      "stage": "normalize",
      "match": {},
      "action": {
        "kind": "filename",
        "extFromQuery": [
          "format",
          "ext",
          "fm"
        ]
      }
    },
    {
      "id": "builtin.track.bilibili",
      "version": 1,
      "tier": "builtin",
      "stage": "track",
      "match": {
        "host": [
          "bilibili.com",
          "bilivideo.com",
          "bilivideo.cn",
          "acgvideo.com"
        ]
      },
      "action": {
        "kind": "track",
        "source": "filenameOrUrl",
        "pattern": "[-_](\\d{4,6})\\.m4s(?:[?#]|$)",
        "group": 1,
        "audio": [
          "30216",
          "30232",
          "30280",
          "30250",
          "30251"
        ],
        "fallback": "video"
      }
    },
    {
      "id": "builtin.track.bilibili-page",
      "version": 1,
      "tier": "builtin",
      "stage": "track",
      "match": {
        "pageHost": [
          "bilibili.com",
          "bilivideo.com",
          "bilivideo.cn",
          "acgvideo.com"
        ]
      },
      "action": {
        "kind": "track",
        "source": "filenameOrUrl",
        "pattern": "[-_](\\d{4,6})\\.m4s(?:[?#]|$)",
        "group": 1,
        "audio": [
          "30216",
          "30232",
          "30280",
          "30250",
          "30251"
        ],
        "fallback": "video"
      }
    },
    {
      "id": "builtin.extract.lanzou",
      "version": 1,
      "tier": "builtin",
      "stage": "body",
      "match": {
        "url": [
          "*/ajaxm.php*"
        ]
      },
      "action": {
        "kind": "extract",
        "when": [
          {
            "path": "zt",
            "equals": 1
          }
        ],
        "fields": {
          "dom": "dom",
          "url": "url",
          "name": "inf"
        },
        "emit": {
          "mode": "preempt",
          "url": {
            "resolve": {
              "base": "${dom}",
              "ref": "${url}",
              "bareQueryPrefix": "/file/"
            }
          },
          "filename": "${name}"
        }
      }
    }
